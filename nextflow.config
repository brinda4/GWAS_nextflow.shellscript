/*
========================================================================================
   GWAS Analysis Nextflow Pipeline Configuration
========================================================================================
*/

params {
    // Pipeline inputs
    raw_data_dir        = "${projectDir}/data/raw"
    associations_zip    = "${params.raw_data_dir}/gwas_catalog_associations.zip"
    ancestry_tsv        = "${params.raw_data_dir}/gwas_catalog_ancestry.tsv"
    
    // Filtering thresholds
    min_raf             = 0.005
    max_raf             = 0.020
    chunk_size          = 100000
    
    // Remote URLs (if downloading)
    associations_url    = "https://www.ebi.ac.uk/gwas/api/search/downloads/associations/v1.0.2?split=false"
    ancestry_url        = "https://ftp.ebi.ac.uk/pub/databases/gwas/releases/latest/gwas-catalog-ancestry.tsv"
    
    // Outputs
    outdir              = "${projectDir}/results"
    
    // Help flag
    help                = false
}

// Manifest metadata
manifest {
    name            = 'gwas-analysis-pipeline'
    author          = 'GWAS Research Team'
    homePage        = 'https://github.com/your-username/gwas-analysis-pipeline'
    description     = 'Automated Nextflow DSL2 pipeline for GWAS Catalog low-frequency variant filtering and gene-disease population mapping.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    conda {
        process.conda = "${projectDir}/environment.yml"
    }
    
    docker {
        docker.enabled = true
        docker.userEmulation = true
        process.container = 'biocontainers/biocontainers:v1.2.0_cv1'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'batch'
    }
}

// Default process configuration
process {
    cpus   = 2
    memory = '4 GB'
    time   = '2h'
    
    withName: 'DOWNLOAD_DATA' {
        time = '1h'
    }
    
    withName: 'FILTER_LOW_FREQUENCY' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }
    
    withName: 'MAP_GENE_DISEASE' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }
}

// Pipeline reporting
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
